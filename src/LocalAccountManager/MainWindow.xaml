<Window x:Class="LocalAccountManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager · Local" Style="{StaticResource {x:Type Window}}" Width="1220" Height="800" MinWidth="1060" MinHeight="710" WindowStartupLocation="CenterScreen">
  <Grid Margin="26,22,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#253629" CornerRadius="12" Padding="12,6" Margin="0,0,16,0"><TextBlock Text="●  LOCAL STORAGE" Foreground="#C3F27D" FontSize="11" FontWeight="SemiBold"/></Border>
        <Button Content="Data &amp; backups" Click="Data_Click"/><Button Content="About" Click="About_Click" Margin="0"/>
      </StackPanel>
      <StackPanel><TextBlock Text="ACCOUNT MANAGER" Foreground="#C3F27D" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Your Roblox accounts" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="Switch accounts. Keep your sessions together." Foreground="{StaticResource Muted}"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="Search" TextChanged="Filter_Changed" ToolTip="Search username, alias, group, or notes" VerticalContentAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Search accounts"/>
      <ComboBox x:Name="Groups" Grid.Column="1" SelectionChanged="Group_Changed" Margin="0,0,14,0" AutomationProperties.Name="Filter by group"/>
      <Button x:Name="AddButton" Grid.Column="2" Content="+  Add account ▾" Style="{StaticResource Primary}" Click="Add_Click" Margin="0">
        <Button.ContextMenu><ContextMenu><MenuItem Header="Browser login" Click="ManualAdd_Click"/><MenuItem Header="Username and password…" Click="SingleAdd_Click"/><MenuItem Header="Bulk username;password;group…" Click="BulkAdd_Click"/></ContextMenu></Button.ContextMenu>
      </Button>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="322"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="#2A313E" BorderThickness="1" Padding="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="15,13"><TextBlock x:Name="CountLabel" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="StarredOnly" Content="Favorites only" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/></DockPanel>
          <Grid Grid.Row="1">
            <DataGrid x:Name="AccountsGrid" SelectionChanged="Accounts_Changed" MouseDoubleClick="Accounts_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Star}" Width="32" CanUserSort="False"/>
                <DataGridTemplateColumn Header="ACCOUNT" Width="*" MinWidth="180" SortMemberPath="Username"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Handle}" Foreground="#9BA8BB" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding CredentialLabel}" Foreground="#79869A" FontSize="10" Margin="0,1,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="105"/>
                <DataGridTemplateColumn Header="SESSION" Width="150" SortMemberPath="LastUsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SessionStatus}" Foreground="{Binding SessionColor}" ToolTip="{Binding SessionCheckLabel}" FontSize="11"/><TextBlock Text="{Binding LastUsedLabel}" Foreground="#9BA8BB" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="18">
              <TextBlock Text="◇" FontSize="44" Foreground="#C3F27D" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyTitle" Text="A home for every account" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
              <TextBlock x:Name="EmptyCopy" Text="Add an account and sign in on Roblox to get started." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
            </StackPanel>
          </Grid>
          <WrapPanel Grid.Row="2" Margin="12">
            <Button Content="Edit" Click="Edit_Click"/><Button Content="Bulk edit…" Click="BulkEdit_Click"/><Button Content="Password…" Click="Password_Click"/><Button Content="★" ToolTip="Toggle favorite" Click="Star_Click"/><Button Content="↑" ToolTip="Move account up" Click="Up_Click"/><Button Content="↓" ToolTip="Move account down" Click="Down_Click"/><Button Content="Sign out" Click="SignOut_Click"/><Button Content="Remove" Click="Remove_Click" Margin="0"/>
          </WrapPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="{StaticResource Surface}" BorderBrush="#2A313E" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="LAUNCH AN EXPERIENCE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectedLabel" Text="Select an account" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Place ID or Roblox game / server link" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
            <TextBox x:Name="PlaceInput" AutomationProperties.Name="Place ID or Roblox game link" MaxLength="4096"/>
            <TextBlock Text="Server Job ID · optional" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,6"/>
            <TextBox x:Name="JobInput" AutomationProperties.Name="Server Job ID" MaxLength="40"/>
            <Button Content="▶   Join server" Style="{StaticResource Primary}" Click="Join_Click" Margin="0,16,0,8" Padding="12,11"/>
            <UniformGrid Columns="2"><Button Content="Open browser" Click="Browser_Click"/><Button Content="Check session" Click="Check_Click" Margin="0"/></UniformGrid>
            <Button Content="Sign in · fill saved login" Click="SignIn_Click" Margin="0,8,0,0" ToolTip="Opens Roblox login and fills the saved username and password. You complete the login and any verification."/>
            <Button Content="Open browser with code…" Click="BrowserCode_Click" Margin="0,8,0,0" ToolTip="Run JavaScript sequentially for the selected accounts, or generate the group-join example."/>
            <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Server list" Click="Servers_Click"/><Button Content="Save target" Click="SaveTarget_Click" Margin="0"/></UniformGrid>
            <CheckBox x:Name="MultiInstance" Content="Multi-instance · experimental" Checked="Multi_Changed" Unchecked="Multi_Changed" Margin="0,16,0,0" ToolTip="Legacy mutex method. Enable with Roblox closed. Compatibility depends on the current Roblox client."/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Surface}" BorderBrush="#2A313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
          <StackPanel>
            <DockPanel Margin="6,0,0,10"><Button Content="+ Favorite" DockPanel.Dock="Right" Click="Bookmark_Click" Padding="8,5" Margin="0"/><TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            <TabControl Height="140"><TabItem Header="Favorites"><ListBox x:Name="FavoritesList" DisplayMemberPath="Name" MouseDoubleClick="Bookmark_DoubleClick"/></TabItem><TabItem Header="Recent"><ListBox x:Name="RecentList" DisplayMemberPath="Name" MouseDoubleClick="Recent_DoubleClick"/></TabItem></TabControl>
            <DockPanel Margin="4,8,0,0"><Button Content="Remove favorite" DockPanel.Dock="Right" Click="RemoveBookmark_Click" Padding="8,4" FontSize="11" Margin="0"/><TextBlock Text="Double-click to load" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="v1.3.1  ·  Portable" Foreground="#68758A" FontSize="11" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="Ready. Add an account to begin." Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="990" HorizontalAlignment="Left" FontSize="12"/></DockPanel>
  </Grid>
</Window>
