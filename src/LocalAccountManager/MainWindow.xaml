<Window x:Class="LocalAccountManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager · Local" Style="{StaticResource {x:Type Window}}" Width="1220" Height="800" MinWidth="1060" MinHeight="710" WindowStartupLocation="CenterScreen">
  <Grid Margin="26,22,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vault security…" Click="VaultSecurity_Click"/><Button Content="Data &amp; backups" Click="Data_Click"/><Button Content="About" Click="About_Click" Margin="0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock x:Name="UpdateStatus" Text="Updates are installed only when you choose." Foreground="{StaticResource Muted}" FontSize="11" MaxWidth="240" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="UpdateButton" Content="Check for updates" Click="Update_Click" Margin="0" Padding="10,5"/></StackPanel>
      </StackPanel>
      <StackPanel><TextBlock Text="ACCOUNT MANAGER" Foreground="#C3F27D" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Your Roblox accounts" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock x:Name="ProtectionStatus" Text="Master password protection" Foreground="{StaticResource Muted}"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="Search" TextChanged="Filter_Changed" ToolTip="Search username, alias, group, or notes" VerticalContentAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Search accounts"/>
      <ComboBox x:Name="Groups" Grid.Column="1" SelectionChanged="Group_Changed" Margin="0,0,14,0" AutomationProperties.Name="Filter by group"/>
      <Button x:Name="AddButton" Grid.Column="2" Content="+  Add account ▾" Style="{StaticResource Primary}" Click="Add_Click" Margin="0">
        <Button.ContextMenu><ContextMenu><MenuItem Header="Browser login" Click="ManualAdd_Click"/><MenuItem Header="Username and password…" Click="SingleAdd_Click"/><MenuItem Header="Bulk username;password;group;note…" Click="BulkAdd_Click"/></ContextMenu></Button.ContextMenu>
      </Button>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="322"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="#2A313E" BorderThickness="1" Padding="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="15,13"><TextBlock x:Name="CountLabel" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="StarredOnly" Content="Favorites only" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"/></DockPanel>
          <Grid Grid.Row="1">
            <DataGrid x:Name="AccountsGrid" RowHeight="78" SelectionChanged="Accounts_Changed" MouseDoubleClick="Accounts_DoubleClick">
              <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
                <DataTrigger Binding="{Binding HasRestriction}" Value="True"><Setter Property="Background" Value="#3C2027"/><Setter Property="BorderBrush" Value="#C85361"/><Setter Property="BorderThickness" Value="3,0,0,0"/></DataTrigger>
              </Style.Triggers></Style></DataGrid.RowStyle>
              <DataGrid.Resources><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Style.Triggers>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasRestriction}" Value="True"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#66313D"/><Setter Property="Foreground" Value="#FFF0F2"/></MultiDataTrigger>
              </Style.Triggers></Style></DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Star}" Width="32" CanUserSort="False"/>
                <DataGridTemplateColumn Header="ACCOUNT" Width="*" MinWidth="180" SortMemberPath="Username"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Handle}" Foreground="#9BA8BB" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding CredentialLabel}" Foreground="#79869A" FontSize="10" Margin="0,1,0,0"/><TextBlock x:Name="AgeGroupStatus" Text="{Binding AgeGroupLabel}" ToolTip="{Binding AgeGroupDetails}" Foreground="#9BCBF1" FontSize="10" Margin="0,2,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="NOTE" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NotePreview}" ToolTip="{Binding Notes}" Foreground="#A9B3C5" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="105"/>
                <DataGridTemplateColumn Header="STATUS" Width="185" SortMemberPath="LastUsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding SessionStatus}" Foreground="{Binding SessionColor}" ToolTip="{Binding SessionCheckLabel}" FontSize="11"/><TextBlock Text="{Binding ModerationLabel}" Foreground="{Binding ModerationColor}" ToolTip="{Binding ModerationDetails}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding ModerationTiming}" Foreground="#A9B3C5" FontSize="10"/><TextBlock Text="{Binding LastUsedLabel}" Foreground="#79869A" FontSize="10" Margin="0,2,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="18">
              <TextBlock Text="◇" FontSize="44" Foreground="#C3F27D" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyTitle" Text="A home for every account" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
              <TextBlock x:Name="EmptyCopy" Text="Add an account and sign in on Roblox to get started." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"/>
            </StackPanel>
          </Grid>
          <WrapPanel Grid.Row="2" Margin="12">
            <Button Content="Edit" Click="Edit_Click"/><Button Content="Bulk edit…" Click="BulkEdit_Click"/><Button Content="Password…" Click="Password_Click"/><Button Content="★" ToolTip="Toggle favorite" Click="Star_Click"/><Button Content="↑" ToolTip="Move account up" Click="Up_Click"/><Button Content="↓" ToolTip="Move account down" Click="Down_Click"/><Button Content="Sign out" Click="SignOut_Click"/><Button Content="Remove" Click="Remove_Click" Margin="0"/>
          </WrapPanel>
        </Grid>
      </Border>
      <TabControl Grid.Column="2" x:Name="AccountTabs" Background="{StaticResource Surface}" BorderBrush="#2A313E" Padding="4">
        <TabControl.Resources><Style TargetType="{x:Type TabItem}"><Setter Property="Background" Value="#252C37"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}"><Border Background="{TemplateBinding Background}" BorderBrush="#2A313E" BorderThickness="1" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#394435"/><Setter Property="Foreground" Value="#C3F27D"/></Trigger></Style.Triggers></Style></TabControl.Resources>
        <TabItem Header="Launch"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Background="{StaticResource Surface}" BorderBrush="#2A313E" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel>
            <TextBlock Text="LAUNCH AN EXPERIENCE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectedLabel" Text="Select an account" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Place ID or Roblox game / server link" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
            <TextBox x:Name="PlaceInput" AutomationProperties.Name="Place ID or Roblox game link" MaxLength="4096"/>
            <TextBlock Text="Server Job ID · optional" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,6"/>
            <TextBox x:Name="JobInput" AutomationProperties.Name="Server Job ID" MaxLength="40"/>
            <Button Content="▶   Join server" Style="{StaticResource Primary}" Click="Join_Click" Margin="0,16,0,8" Padding="12,11"/>
            <UniformGrid Columns="2"><Button Content="Open browser" Click="Browser_Click"/><Button x:Name="CheckStatusButton" Content="Check status" Click="Check_Click" Margin="0" ToolTip="Check the selected accounts' sessions, ban status, and age groups."/></UniformGrid>
            <Button Content="Sign in · use saved login" Click="SignIn_Click" Margin="0,8,0,0" ToolTip="Fills the saved username and password and presses Log In once. Complete any verification on Roblox."/>
            <Button Content="Open browser with code…" Click="BrowserCode_Click" Margin="0,8,0,0" ToolTip="Run JavaScript sequentially for the selected accounts, or generate the group-join example."/>
            <UniformGrid Columns="2" Margin="0,8,0,0"><Button Content="Server list" Click="Servers_Click"/><Button Content="Save target" Click="SaveTarget_Click" Margin="0"/></UniformGrid>
            <CheckBox x:Name="MultiInstance" Content="Multi-instance · experimental" Checked="Multi_Changed" Unchecked="Multi_Changed" Margin="0,16,0,0" ToolTip="Legacy mutex method. Enable with Roblox closed. Compatibility depends on the current Roblox client."/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Surface}" BorderBrush="#2A313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
          <StackPanel>
            <DockPanel Margin="6,0,0,10"><Button Content="+ Favorite" DockPanel.Dock="Right" Click="Bookmark_Click" Padding="8,5" Margin="0"/><TextBlock Text="QUICK ACCESS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            <TabControl Height="140"><TabItem Header="Favorites"><ListBox x:Name="FavoritesList" DisplayMemberPath="Name" MouseDoubleClick="Bookmark_DoubleClick"/></TabItem><TabItem Header="Recent"><ListBox x:Name="RecentList" DisplayMemberPath="Name" MouseDoubleClick="Recent_DoubleClick"/></TabItem></TabControl>
            <DockPanel Margin="4,8,0,0"><Button Content="Remove favorite" DockPanel.Dock="Right" Click="RemoveBookmark_Click" Padding="8,4" FontSize="11" Margin="0"/><TextBlock Text="Double-click to load" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
          </StackPanel>
        </Border>
      </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="NotesTab" Header="Notes">
          <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="NoteOwner" Text="Select one account" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="NotesHint" Grid.Row="1" Text="Select an account to read its full note." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
            <TextBox x:Name="NotesEditor" Grid.Row="2" TextChanged="Notes_Changed" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False" AutomationProperties.Name="Account note" IsEnabled="False"/>
            <Button x:Name="SaveNotesButton" Grid.Row="3" Content="Save notes" Click="SaveNotes_Click" Style="{StaticResource Primary}" Margin="0,12,0,0" IsEnabled="False"/>
          </Grid>
        </TabItem>
        <TabItem x:Name="ModerationTab" Header="Ban status">
          <DockPanel Margin="14">
            <Button DockPanel.Dock="Bottom" Content="Open account browser" Click="Browser_Click" Margin="0,12,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="ModerationDetails" Text="Select one account to see ban status, duration, and the latest check." TextWrapping="Wrap" Foreground="#DCE2EC" LineHeight="21"/>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="v1.5.4  ·  Portable" Foreground="#68758A" FontSize="11" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="Ready. Add an account to begin." Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="990" HorizontalAlignment="Left" FontSize="12"/></DockPanel>
  </Grid>
</Window>
