<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface" Color="#171B23"/>
    <SolidColorBrush x:Key="Muted" Color="#969EAE"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#101319"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Icon" Value="pack://application:,,,/RobloxAccountManager;component/Assets/AppIcon.ico"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="Background" Value="#242B37"/><Setter Property="BorderBrush" Value="#354052"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#C3F27D"/><Setter Property="Foreground" Value="#17210E"/><Setter Property="BorderBrush" Value="#C3F27D"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#10151D"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="CaretBrush" Value="#C3F27D"/><Setter Property="BorderBrush" Value="#354052"/><Setter Property="Padding" Value="10,8"/><Setter Property="SelectionBrush" Value="#526B35"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#10151D"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="BorderBrush" Value="#354052"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#161C26"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE2EC"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#171B23"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#171B23"/><Setter Property="AlternatingRowBackground" Value="#1A1F28"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="62"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202630"/><Setter Property="Foreground" Value="#9DA9BB"/><Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2D3B31"/><Setter Property="Foreground" Value="#F0FFE2"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="#171B23"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#141A22"/><Setter Property="Padding" Value="18,8"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#171B23"/><Setter Property="Foreground" Value="#EEF1F6"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#344333"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  </ResourceDictionary>
