<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RobloxAccountManager</AssemblyName>
    <RootNamespace>LocalAccountManager</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 AI Roblox Account Manager contributors. See NOTICE.md.</Copyright>
    <Description>Unofficial portable Windows account manager for Roblox.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <EmbeddedResource Include="../../examples/join-group.js" LogicalName="LocalAccountManager.JoinGroup.js" />
    <EmbeddedResource Include="Assets/UpdatePublicKey.bin" LogicalName="LocalAccountManager.UpdatePublicKey" />
    <EmbeddedResource Include="Assets/BrowserSolvers.js" LogicalName="LocalAccountManager.BrowserSolvers.js" />
    <Resource Include="Assets/AppIcon.ico" />
  </ItemGroup>
</Project>
